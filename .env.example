# =============================================================================
# Environment Configuration for ScenarioBuilder
# =============================================================================
# Copy this file to .env and adjust values for your environment

# -----------------------------------------------------------------------------
# Combined App Configuration (FastAPI + Flask Auth/API + Gradio UI)
# =============================================================================
FLASK_ENV=development

# Server binding (unified app on single port)
HOST=0.0.0.0
PORT=8000

# =============================================================================
# PostgreSQL Database
# =============================================================================
POSTGRES_DB=your-database
POSTGRES_USER=your-username
POSTGRES_PASSWORD=your-password
POSTGRES_PORT=5432

# Connection string (for Docker: use 'db' as hostname, for local: 'localhost')
DATABASE_URL=postgresql://your-username:your-password@localhost:5432/your-database

# =============================================================================
# Application Defaults
# =============================================================================
